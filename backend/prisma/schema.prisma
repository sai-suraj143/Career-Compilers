generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips          Trip[]
  notes          Note[]
  checklistItems ChecklistItem[]
}

model Trip {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops          Stop[]
  budget         Budget?
  checklistItems ChecklistItem[]
  notes          Note[]
}

enum Visibility {
  PRIVATE
  PUBLIC
}

model Stop {
  id            String   @id @default(uuid())
  tripId        String
  cityName      String
  country       String
  arrivalDate   DateTime
  departureDate DateTime
  orderIndex    Int

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]
  notes      Note[]
}

model Activity {
  id           String   @id @default(uuid())
  stopId       String
  title        String
  category     String
  cost         Float    @default(0.0)
  duration     Int?     // in minutes
  activityDate DateTime
  description  String?
  imageUrl     String?

  stop Stop @relation(fields: [stopId], references: [id], onDelete: Cascade)
}

model Budget {
  id            String @id @default(uuid())
  tripId        String @unique
  transportCost Float  @default(0.0)
  stayCost      Float  @default(0.0)
  foodCost      Float  @default(0.0)
  activityCost  Float  @default(0.0)
  totalCost     Float  @default(0.0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id       String  @id @default(uuid())
  tripId   String
  userId   String
  itemName String
  category String?
  isPacked Boolean @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  tripId    String
  stopId    String?
  userId    String
  content   String
  createdAt DateTime @default(now())

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop Stop? @relation(fields: [stopId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
